# Copy to .env.local and fill in. Never commit real values (.env* is git-ignored).

# --- Next.js app ----------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key: safe in the browser; RLS limits it to approved public data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# The only address the admin sign-in form sends magic links to (server-side only).
ADMIN_EMAIL=
# Fallback origin for magic-link redirects when the request has no Origin header.
SITE_URL=http://localhost:3000

# --- Supabase Edge Function secrets (set with `npx supabase secrets set`, not here) --
# RESEARCH_CRON_SECRET=         shared secret pg_cron sends to research-discover (also in Vault as research_cron_secret)
# RESEARCH_CONTACT_EMAIL=       contact address for the Crossref / OpenAlex polite pool only (phase 4)
# OPENALEX_API_KEY=             optional; without it OpenAlex shares a tiny anonymous budget and often refuses
# ANTHROPIC_API_KEY=            Claude API key for research analysis (phase 5)
